{
	"bsonType": "object",
	"description": "用户金币变更表",
	"required": [],
	"permission": {
		"read": true,
		"create": true,
		"update": true,
		"delete": true
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"user_id": {
			"bsonType": "string",
			"description": "用户id，参考uni-id-users表",
			"foreignKey": "user-accounts._id",
			"defaultValue": ""
		},
		"coin": {// 用于金币，由于inc自增方法，只支持int整数，不支持小数，所以这里用int
			"bsonType": "int",
			"title": "本次变化的金币",
			"description": "本次变化的金币"
		},
		"type": {
			"bsonType": "int",
			"enum": [
				1,
				2
			],
			"description": "金币类型 1:收入 2:支出"
		},
		"balance": {
			"bsonType": "int",
			"title": "金币余额",
			"description": "变化后的积分（金币）余额"
		},
		"comment": {
			"bsonType": "string",
			"description": "备注，说明积分（金币）新增、消费的缘由",
			"trim": "both"
		},
		"create_date": {
			"bsonType": "timestamp",
			"description": "创建时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		}
	},
	"version": "0.0.1"
}