// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
{
	"bsonType": "object",
	"description": "采集任务设计表（爬网程序任务）",
	"required": ["task_title", "urls", "source_url_selector", "title_selector", "nickname_selector", "your_story_selector"],
	"permission": {
		"read": true,
		"create": true,
		"update": true,
		"delete": true
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"// 主键，唯一标识每个采集任务。
		},
		"task_title": {
			"bsonType": "string",
			"title": "任务名",
			"description": "采集任务名字",
			"trim": "end",
			"errorMessage": "{title}不能为空"
		},
		"urls": {
			"bsonType": "string",
			"title": "采集地址",
			"description": "存储要采集的地址，一行一个URL",
			"trim": "end",
			"errorMessage": "{title}不能为空"
		},
		"source_url_selector": {
			"bsonType": "string",
			"title": "source_url 选择器",
			"description": "source_url 选择器",
			"errorMessage": "{title}不能为空"
		},
		"title_selector": {
			"bsonType": "string",
			"title": "title 选择器",
			"description": "title 选择器",
			"errorMessage": "{title}不能为空"
		},
		"nickname_selector": {
			"bsonType": "string",
			"title": "creator_user.nickname 选择器",
			"description": "creator_user.nickname 选择器",
			"errorMessage": "{title}不能为空"
		},
		"your_story_selector": {
			"bsonType": "string",
			"title": "your_story 选择器",
			"description": "your_story 选择器",
			"errorMessage": "{title}不能为空"
		},
		"your_story_img_selector": {
			"bsonType": "string",
			"title": "your_story 图片选择器",
			"description": "your_story 图片选择器",
			"defaultValue": "img"
		},
		"your_story_src_prefix": {
			"bsonType": "string",
			"title": "your_story 图片 src 前缀",
			"description": "your_story 图片 src 前缀",
			"defaultValue": ""
		},
		"your_story_description_selector": {
			"bsonType": "string",
			"title": "your_story.description 选择器",
			"description": "your_story.description 选择器",
			"defaultValue": ""
		}
	}
}