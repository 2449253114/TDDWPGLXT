// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
{
	"bsonType": "object",
	"description": "GIF封面与文件关联表",
	"required": ["file_id", "video_segment_id", "gif_cover_file_fsid"],
	"permission": {
		"read": true,
		"create": true,
		"update": true,
		"delete": true
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"file_id": {
			"bsonType": "int",
			"foreignKey": "yike-album-files.fsid",
			"description": "主视频文件ID，关联Files表指向原始视频文件"
		},
		"video_segment_id": {
			"bsonType": "string",
			"foreignKey": "VideoSegments.video_segment_id",
			"description": "对应的视频片段ID，关联VideoSegments表"
		},
		"gif_cover_file_fsid": {
			"bsonType": "int",
			"description": "GIF封面图文件fsid，这个fsid不存储在Files表中，但与一刻相册中的某个文件相关联，主要用于自动化采集“GIF图封面的URL”"
		},
		"gif_cover_file_url": {
			"bsonType": "string",
			"description": "GIF封面图的URL"
		},
		"create_date": {
			"bsonType": "timestamp",
			"label": "创建时间",
			"defaultValue": {
				"$env": "now"
			},
			"componentForEdit": {
				"name": "uni-dateformat"
			}
		}
	}
}