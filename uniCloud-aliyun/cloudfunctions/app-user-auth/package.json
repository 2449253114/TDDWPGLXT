{
	"name": "app-user-auth",
	"description": "每周一至周三的凌晨2点重置",
	"dependencies": {},
	"extensions": {
		"uni-cloud-jql": {}
	},
	"cloudfunction-config": {
		"concurrency": 10,
		"memorySize": 512,
		"timeout": 600,
		"triggers": [{
			"name": "myTrigger",
			"type": "timer",
			"config": "0 0 2 * * 1-3 *"
		}],
		"path": "/api/users",
		"runtime": "Nodejs16"
	}
}